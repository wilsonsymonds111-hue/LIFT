{
  "name": "WorkoutTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "exercises": {
      "type": "string"
    },
    "exerciseList": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sets": {
            "type": "number"
          },
          "muscle": {
            "type": "string"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "lastPerformed": {
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    },
    "is_example": {
      "type": "boolean",
      "description": "True if this is a seeded example template shown in the Example Templates section"
    }
  },
  "required": [
    "name"
  ]
}