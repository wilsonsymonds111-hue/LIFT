{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "profilePhoto": {
      "type": "string",
      "description": "URL of the user's profile photo"
    },
    "bodyWeightGoal": {
      "type": "object",
      "description": "The user's body weight goal including target, weekly rate, and projected date",
      "properties": {
        "current": {
          "type": "number"
        },
        "goal": {
          "type": "number"
        },
        "weeklyChange": {
          "type": "number"
        },
        "daysToGoal": {
          "type": "number"
        },
        "goalDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "goalMode": {
      "type": "string",
      "enum": [
        "cutting",
        "bulking"
      ],
      "description": "Whether the user is cutting or bulking"
    }
  },
  "required": [
    "role"
  ]
}