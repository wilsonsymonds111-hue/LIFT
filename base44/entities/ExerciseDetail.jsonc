{
  "name": "ExerciseDetail",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "muscles_worked": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}